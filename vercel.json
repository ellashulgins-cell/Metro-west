{
  "rewrites": [
    { "source": "/", "destination": "/Metro_RP_3D_Viewer.html" },
    { "source": "/__admin", "destination": "/__admin/index.html" },
    { "source": "/__admin/", "destination": "/__admin/index.html" }
  ],
  "headers": [
    {
      "source": "/metrorp_q_underground_west.bsp",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/found_models/metro_props.bin",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/__admin/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
